# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored: never commit real credentials.

# PostgreSQL connection (read automatically by the "pg" driver)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=civicpulse

# Secret used to sign login sessions (any random string, at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
